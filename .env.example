# =============================================================================
# Synchrony Dynamic Risk Assessment - environment configuration
# Copy this file to .env and fill in the values. Never commit .env.
# =============================================================================

# ---- Security (required) ----------------------------------------------------
# JWT signing secret. Must be at least 32 bytes. Generate a strong random value.
#   openssl rand -base64 48
JWT_SECRET=

# Access token lifetime in minutes.
JWT_EXPIRATION_MINUTES=120

# ---- Database ---------------------------------------------------------------
DB_NAME=synchrony
DB_USERNAME=synchrony
DB_PASSWORD=synchrony
# Used by the backend when run outside compose. Inside compose the host is "db".
DB_URL=jdbc:postgresql://localhost:5432/synchrony

# ---- Frontend ---------------------------------------------------------------
# Origins allowed to call the API directly. The Vite dev server uses 5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- AWS Bedrock (Explainable AI orchestrator) ------------------------------
# Leave disabled to use the deterministic fallback. When enabled, standard AWS
# credential resolution applies (environment, profile or instance role). No
# credentials are ever stored in this file.
BEDROCK_ENABLED=false
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# ---- Scoring strategy (optional overrides) ----------------------------------
SCORING_APPROVE_THRESHOLD=640
SCORING_DECLINE_THRESHOLD=580

# ---- Demo seed (local only) -------------------------------------------------
SEED_ENABLED=true
SEED_OFFICER_USERNAME=officer
SEED_OFFICER_PASSWORD=Officer#2024
SEED_APPLICANT_PASSWORD=Applicant#2024
